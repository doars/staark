{
	"private": true,
	"name": "@doars/staark-workspace",
	"workspaces": [
		"docs-src",
		"packages/*",
		"performance"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "npm run build --workspace=./packages",
		"check": "npm run check --workspace=./packages",
		"check:write": "npm run check:write --workspace=./packages",
		"release": "node ./helpers/release.js",
		"serve": "node ./helpers/serve.js ./",
		"test": "node --test packages/*/tst/**/*.test.js",
		"test:watch": "node --test --watch packages/*/tst/**/*.test.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"esbuild": "^0.28.2",
		"happy-dom": "^21.0.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.2": true
	}
}
