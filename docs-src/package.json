{
	"private": true,
	"name": "@doars/staark-docs",
	"version": "0.0.0",
	"type": "module",
	"dependencies": {
		"@doars/staark": "x",
		"highlight.js": "^11.11.1"
	},
	"scripts": {
		"build": "NODE_ENV=production node ./build.js",
		"check": "biome check ./src/**/*.js ./build.js",
		"check:write": "biome check --write ./src/**/*.js ./build.js",
		"develop": "NODE_ENV=development node --watch ./build.js",
		"serve": "node ../helpers/serve.js ../docs/"
	}
}
